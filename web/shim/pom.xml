<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.nate314.oldjava</groupId>
    <artifactId>web</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>
  <artifactId>shim</artifactId>
  <name>AWT/Swing/MIDI shim for TeaVM</name>

  <dependencies>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-jso-apis</artifactId>
    </dependency>
    <!-- Compiler-side SPI (class substitution, reflection, bytecode transformer). Only the TeaVM compiler loads these classes. -->
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-extension-spi</artifactId>
      <version>${teavm.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Runs every test/**/*Check (DragsCheck against the compiled ShimPlugin, Geometry/Layer/TextChange against the shim classes) on every build (no test framework). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>shim-checks</id>
            <phase>test</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target>
                <property name="checks" location="${project.build.directory}/checks"/>
                <mkdir dir="${checks}"/>
                <javac srcdir="${project.basedir}/test" includes="**/*Check.java" destdir="${checks}"
                       classpathref="maven.compile.classpath" release="${maven.compiler.release}"
                       encoding="UTF-8" includeantruntime="false"/>
                <macrodef name="check">
                  <attribute name="class"/>
                  <sequential>
                    <java classname="@{class}" fork="true" failonerror="true">
                      <jvmarg value="-ea"/>
                      <jvmarg value="-Djava.awt.headless=true"/>
                      <classpath>
                        <pathelement location="${checks}"/>
                        <path refid="maven.compile.classpath"/>
                      </classpath>
                    </java>
                  </sequential>
                </macrodef>
                <check class="web.teavm.DragsCheck"/>
                <check class="web.shim.java.awt.GeometryCheck"/>
                <check class="web.shim.javax.swing.LayerCheck"/>
                <check class="web.shim.javax.swing.TextChangeCheck"/>
                <check class="web.shim.javax.swing.NearLabelCheck"/>
                <check class="web.shim.java.awt.geom.TransformCheck"/>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
