<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.nate314.oldjava</groupId>
    <artifactId>web</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>
  <artifactId>apps</artifactId>
  <name>Apps compiled to JavaScript</name>

  <!-- The shim must stay first: TeaVM tries class substitution rules in classpath order. -->
  <dependencies>
    <dependency>
      <groupId>io.github.nate314.oldjava</groupId>
      <artifactId>shim</artifactId>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-classlib</artifactId>
    </dependency>
    <dependency>
      <groupId>org.teavm</groupId>
      <artifactId>teavm-jso-apis</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Compile the untouched app sources straight from the repo. Their package names do not clash. -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>app-sources</id>
            <goals><goal>add-source</goal></goals>
            <configuration>
              <sources>
                <source>${repo.dir}/CircleSpawner/src</source>
                <source>${repo.dir}/Clock/src</source>
                <source>${repo.dir}/FlappyBird/src</source>
                <source>${repo.dir}/Minesweeper/src</source>
                <source>${repo.dir}/RubiksCube2D/src</source>
                <source>${repo.dir}/ScreenSaver/src</source>
                <source>${repo.dir}/SpriteFloatyStars/src</source>
                <source>${repo.dir}/StockChecker/src</source>
                <source>${repo.dir}/SynthesizerKeyboard/src</source>
                <source>${repo.dir}/UltimateTicTacToe/src</source>
                <source>${repo.dir}/GroupCreator/src</source>
                <source>${repo.dir}/MusicTheoryExpert/src</source>
                <source>${repo.dir}/NumberGuess/src</source>
                <source>${repo.dir}/SimpleAlgorithms/src</source>
                <source>${repo.dir}/TankGame/src</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>site-pages</id>
            <phase>process-resources</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${site.dir}</outputDirectory>
              <resources><resource><directory>${project.basedir}/../site</directory></resource></resources>
            </configuration>
          </execution>
          <execution>
            <id>flappybird-images</id>
            <phase>process-resources</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${site.dir}/FlappyBird</outputDirectory>
              <resources>
                <resource>
                  <directory>${repo.dir}/FlappyBird/src</directory>
                  <includes><include>*.jpg</include><include>*.png</include></includes>
                </resource>
              </resources>
            </configuration>
          </execution>
          <execution>
            <id>stockchecker-files</id>
            <phase>process-resources</phase>
            <goals><goal>copy-resources</goal></goals>
            <configuration>
              <outputDirectory>${site.dir}/StockChecker</outputDirectory>
              <resources>
                <resource>
                  <directory>${repo.dir}/StockChecker</directory>
                  <includes><include>myStocks.txt</include><include>stockCheck.csv</include></includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- The source viewer (boot.js): each app page gets its README and Java sources under source/, with
           source/files.txt listing them. NathaNOS's page is built by the nathanos module, but its sources are
           copied here with the others. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>app-sources-for-viewer</id>
            <phase>process-resources</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target>
                <property name="repo" location="${repo.dir}"/>
                <macrodef name="appsource">
                  <attribute name="app"/>
                  <sequential>
                    <copy todir="${site.dir}/@{app}/source">
                      <fileset dir="${repo}/@{app}" includes="README.md src/**/*.java"/>
                    </copy>
                    <pathconvert property="source.@{app}" pathsep="${line.separator}" dirsep="/">
                      <fileset dir="${repo}/@{app}" includes="README.md src/**/*.java"/>
                      <globmapper from="${repo}/@{app}/*" to="*" handledirsep="true"/>
                    </pathconvert>
                    <echo file="${site.dir}/@{app}/source/files.txt" message="${source.@{app}}${line.separator}"/>
                  </sequential>
                </macrodef>
                <appsource app="CircleSpawner"/>
                <appsource app="Clock"/>
                <appsource app="FlappyBird"/>
                <appsource app="Minesweeper"/>
                <appsource app="NathaNOS"/>
                <appsource app="RubiksCube2D"/>
                <appsource app="ScreenSaver"/>
                <appsource app="SpriteFloatyStars"/>
                <appsource app="StockChecker"/>
                <appsource app="SynthesizerKeyboard"/>
                <appsource app="UltimateTicTacToe"/>
                <appsource app="GroupCreator"/>
                <appsource app="MusicTheoryExpert"/>
                <appsource app="NumberGuess"/>
                <appsource app="SimpleAlgorithms"/>
                <appsource app="TankGame"/>
              </target>
            </configuration>
          </execution>
          <!-- Link previews: the share tags web/cards.ps1 writes into every page point at the page and its card
               with relative addresses. Built with -Dsite.url=https://host/path, they become absolute, which
               most link preview services need. -->
          <execution>
            <id>absolute-share-tags</id>
            <phase>process-resources</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target xmlns:if="ant:if">
                <condition property="share.absolute"><length string="${site.url}" when="greater" length="0" trim="true"/></condition>
                <replaceregexp if:set="share.absolute" match="(&lt;meta (?:property=&quot;og:(?:url|image)&quot;) content=&quot;)(?:\.\./)?" replace="\1${site.url}/" flags="g" encoding="UTF-8">
                  <fileset dir="${site.dir}" includes="index.html */index.html"/>
                </replaceregexp>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.teavm</groupId>
        <artifactId>teavm-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>CircleSpawner</id>
            <goals><goal>compile</goal></goals>
            <configuration>
              <mainClass>circlewindow.Main</mainClass>
              <targetDirectory>${site.dir}/CircleSpawner</targetDirectory>
            </configuration>
          </execution>
          <execution>
            <id>Clock</id>
            <goals><goal>compile</goal></goals>
            <configuration>
              <mainClass>clock.Main</mainClass>
              <targetDirectory>${site.dir}/Clock</targetDirectory>
            </configuration>
          </execution>
          <execution>
            <id>FlappyBird</id>
            <goals><goal>compile</goal></goals>
            <configuration>
              <mainClass>flappyBird.Main</mainClass>
              <targetDirectory>${site.dir}/FlappyBird</targetDirectory>
            </configuration>
          </execution>
          <execution>
            <id>Minesweeper</id>
            <goals><goal>compile</goal></goals>
            <configuration>
              <mainClass>minesweeper.Main</mainClass>
              <targetDirectory>${site.dir}/Minesweeper</targetDirectory>
            </configuration>
          </execution>
          <execution>
            <id>RubiksCube2D</id>
            <goals><goal>compile</goal></goals>
            <configuration>
              <mainClass>rubikscube.Main</mainClass>
              <targetDirectory>${site.dir}/RubiksCube2D</targetDirectory>
            </configuration>
          </execution>
          <execution>
            <id>ScreenSaver</id>
            <goals><goal>compile</goal></goals>
            <configuration>
              <mainClass>screensaver.Main</mainClass>
              <targetDirectory>${site.dir}/ScreenSaver</targetDirectory>
            </configuration>
          </execution>
          <execution>
            <id>SpriteFloatyStars</id>
            <goals><goal>compile</goal></goals>
            <configuration>
              <mainClass>animate2.Animate2Main</mainClass>
              <targetDirectory>${site.dir}/SpriteFloatyStars</targetDirectory>
            </configuration>
          </execution>
          <execution>
            <id>StockChecker</id>
            <goals><goal>compile</goal></goals>
            <configuration>
              <mainClass>stockchecker.Main</mainClass>
              <targetDirectory>${site.dir}/StockChecker</targetDirectory>
            </configuration>
          </execution>
          <execution>
            <id>SynthesizerKeyboard</id>
            <goals><goal>compile</goal></goals>
            <configuration>
              <mainClass>synthesizer.Main</mainClass>
              <targetDirectory>${site.dir}/SynthesizerKeyboard</targetDirectory>
            </configuration>
          </execution>
          <execution>
            <id>UltimateTicTacToe</id>
            <goals><goal>compile</goal></goals>
            <configuration>
              <mainClass>ultimateticktacktoe.Main</mainClass>
              <targetDirectory>${site.dir}/UltimateTicTacToe</targetDirectory>
            </configuration>
          </execution>
          <execution>
            <id>GroupCreator</id>
            <goals><goal>compile</goal></goals>
            <configuration>
              <mainClass>groupcreator.Main</mainClass>
              <targetDirectory>${site.dir}/GroupCreator</targetDirectory>
            </configuration>
          </execution>
          <execution>
            <id>MusicTheoryExpert</id>
            <goals><goal>compile</goal></goals>
            <configuration>
              <mainClass>musictheoryexpert.Main</mainClass>
              <targetDirectory>${site.dir}/MusicTheoryExpert</targetDirectory>
            </configuration>
          </execution>
          <execution>
            <id>NumberGuess</id>
            <goals><goal>compile</goal></goals>
            <configuration>
              <mainClass>numberguess.Main</mainClass>
              <targetDirectory>${site.dir}/NumberGuess</targetDirectory>
            </configuration>
          </execution>
          <execution>
            <id>SimpleAlgorithms</id>
            <goals><goal>compile</goal></goals>
            <configuration>
              <mainClass>simplealgorithms.Main</mainClass>
              <targetDirectory>${site.dir}/SimpleAlgorithms</targetDirectory>
            </configuration>
          </execution>
          <execution>
            <id>TankGame</id>
            <goals><goal>compile</goal></goals>
            <configuration>
              <mainClass>tankgame.Main</mainClass>
              <targetDirectory>${site.dir}/TankGame</targetDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
